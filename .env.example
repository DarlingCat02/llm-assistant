# === LLM Provider ===
# Provider: ollama / lm_studio / openrouter
LLM_PROVIDER=ollama

# Server URL (for ollama and lm_studio)
# Ollama: http://localhost:11434
# LM Studio: http://localhost:1234
LLM_HOST=http://localhost:11434

# API key (only needed for openrouter)
# Get one at https://openrouter.ai/keys
LLM_API_KEY=

# Model for generation
# Ollama: qwen2.5:7b, llama3.2:3b, mistral:7b
# LM Studio: any loaded model (e.g., qwen2.5-7b-instruct)
# OpenRouter: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-pro-1.5, qwen/qwen-2.5-72b-instruct
LLM_MODEL=qwen2.5:7b

# Maximum number of context tokens (for Ollama)
LLM_NUM_CTX=8192

# Generation temperature (0.0 - deterministic, 2.0 - creative)
LLM_TEMPERATURE=0.7


# === Ollama API (legacy, for backward compatibility) ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.7


# === ChromaDB ===
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION_NAME=assistant_memory


# === Memory ===
MEMORY_MAX_CONTEXT=20
MEMORY_SEARCH_RESULTS=3
MEMORY_SIMILARITY_THRESHOLD=0.3


# === PyTorch build ===
# Which PyTorch the installer fetches: auto / cuda / cpu
# auto   - CUDA if an NVIDIA GPU is present, CPU otherwise (default)
# cuda   - always the CUDA build
# cpu    - always the CPU build
# Leave it alone unless you know you want it: left to PyPI, torch installs as
# the CPU build, speech recognition falls back to the processor (measured on the
# same 2.5-second clip: 41 s without a GPU against 0.2 s with one) and the VRAM
# features have nothing to work with.
TORCH_BUILD=auto


# === TTS ===
TTS_ENABLED=false
TTS_MODEL=silero_v3
# Save a permanent WAV copy of every synthesis to debug_tts/ for inspection
TTS_DEBUG_SAVE=false


# === Web Interface ===
# There is no WEB_HOST or WEB_PORT setting: the desktop app picks a free port at
# launch (something else on the machine may already hold 8000), so changing
# these two lines would do nothing.


# === GUI ===
GUI_ENABLED=false
GUI_FRAMEWORK=customtkinter
GUI_THEME=dark
GUI_TITLE=Local AI Assistant
GUI_WIDTH=900
GUI_HEIGHT=600


# === Hotkeys (global, applied on app restart) ===
# Format: Ctrl+Shift+V, Alt+F9, Ctrl+Num0, F12, ...
HOTKEY_VOICE=Ctrl+Shift+V
HOTKEY_VOICE_NUM=Ctrl+Num0
HOTKEY_LIVE=Ctrl+Shift+L


# === Speech-to-Text ===
# Whisper model: tiny / base / small / medium / large / large-v3-turbo, 'owner/repo' id or local folder path
STT_MODEL=large-v3-turbo


# === Wake word ===
# Activate the assistant by saying a phrase. Any phrase works, e.g. just the
# assistant name. Turn it on with the input-mode slider above the chat - there
# is no WAKE_ENABLED setting, and while the background listener runs the app
# keeps the microphone open, so it is an explicit opt-in.
# The phrase is recognised with the same Whisper as STT_MODEL below (one model,
# not two), so nothing extra has to be downloaded for this.
WAKE_PHRASE=
WAKE_COOLDOWN=5            # seconds of silence-out after a trigger
WAKE_MATCH_THRESHOLD=0.70  # 0-1, lower = more sensitive to the phrase
# 0.70 was measured, not guessed: 25 ordinary utterances scored at most 0.38
# against the phrase, while a real microphone rendering of the same word came
# out as a near-miss and still scored 0.80. The 0.82 this used to default to
# rejected genuine detections.


# === Language ===
GENERAL_LANGUAGE=en


# === Personality ===
# Extra instructions appended to the system prompt (a layer, not a replacement).
# Managed in Settings -> Personality; newlines are stored escaped as \n
PERSONALITY_RU=
PERSONALITY_EN=


# === Screenshots ===
SCREENSHOT_ENABLED=true
SCREENSHOT_SAVE_PATH=./screenshots
SCREENSHOT_MONITOR=0
SCREENSHOT_TRIGGERS=screen,screenshot,look at screen,show screen,whats on screen,take screenshot

# === Logging ===
LOG_LEVEL=INFO
