# === Secrets and local config ===
# Never commit: real settings may hold API keys.
.env
.env.local
# Backup copies made while editing .env
.env.*
!.env.example

# === Runtime folders ===
# Pattern below keeps the FOLDER in the repo (so a fresh clone has the same
# structure) while never committing its contents.
#
#   <dir>/*        ignore everything inside
#   !<dir>/.gitkeep except the placeholder that makes git keep the dir
#
# Git does not track empty directories, hence the .gitkeep files.

# Uploaded avatars (user/bot pictures)
avatars/*
!avatars/.gitkeep

# TTS voice files (cloned voices)
voices/*
!voices/.gitkeep

# Local model files (Whisper, OmniVoice)
models/*
!models/.gitkeep
# ...but the note explaining what the app expects in here travels with the repo
!models/README.txt

# Runtime data: ChromaDB vector store and chat SQLite database
storage/*
!storage/.gitkeep

# Logs: the app writes its backend log here, so the folder is part of the
# program - but the contents are pure output.
logs/*
!logs/.gitkeep

# Pure output - no placeholder needed
screenshots/
debug_tts/
ffmpeg/

# Voice samples recorded for wake-word calibration (myVoice/) - these are the
# user's own recordings, not project assets.
myVoice/

# Per-user configuration (real files are ignored, templates are committed)
apps.json
personas.json

# === Python ===
venv/
.venv/
*.egg-info/
*.py[cod]
*$py.class
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === Node / Tauri ===
llm-assistant-tauri/node_modules/

# Build output (generated)
llm-assistant-tauri/src-tauri/target/
llm-assistant-tauri/dist/

# Cargo lock (optional - generated)
llm-assistant-tauri/src-tauri/Cargo.lock

# === Installer logs ===
install.log